DATABASE_URL=postgresql://user:password@localhost:5432/cases
# Public origin, HTTPS in production. No trailing path.
APP_ORIGIN=http://localhost:3000
# Generate a random secret (at least 32 characters). Keep it server-side.
AUTH_SECRET=

# Mini App authentication:
TELEGRAM_BOT_TOKEN=
# Website Login / OIDC credentials from BotFather (not the bot token):
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# SMTP provider. Port 465 uses TLS; other ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Case Lab <login@example.com>
