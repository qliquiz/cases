{
    "name": "casego",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "db:migrate": "node scripts/migrate.mjs",
        "bot:check": "node --import tsx scripts/telegram-bot.mts check",
        "bot:setup": "node --import tsx scripts/telegram-bot.mts setup",
        "start": "next start",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test src/game/*.test.ts",
        "test:browser": "node --import tsx scripts/browser-smoke.mts",
        "test:theme": "node --import tsx scripts/theme-smoke.mts",
        "test:collection": "node --import tsx scripts/collection-smoke.mts",
        "test:analytics": "node --import tsx scripts/analytics-browser.mts",
        "test:leaderboard": "node --import tsx scripts/leaderboard-smoke.mts",
        "test:cache": "node --import tsx scripts/query-cache-smoke.mts",
        "test:loading": "node --import tsx scripts/loading-cache-smoke.mts",
        "analytics:report": "node --import tsx scripts/analytics-report.mts"
    },
    "dependencies": {
        "@next/env": "16.3.6",
        "@tanstack/react-query": "^5.104.0",
        "jose": "^6.2.12",
        "next": "16.3.6",
        "nodemailer": "^10.0.10",
        "postgres": "^3.4.9",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.6",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "playwright": "1.63.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5"
    },
    "packageManager": "bun@1.3.13"
}
